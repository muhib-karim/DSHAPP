# ── 构建产物 ─────────────────────────────────────────────
build/
.gradle/
.kotlin/
local.properties

# ── 发行版签名：绝不入库 ─────────────────────────────────
#
# keystore 是应用身份，泄露 = 别人能伪造你的发行包；丢失 = 再也发不出能覆盖
# 升级的包（用户只能卸载重装）。两者都要离线备份。
keystore.properties
*.jks
*.keystore

# ── IDE ──────────────────────────────────────────────────
.idea/
*.iml
.DS_Store

# ── APK 资产：一次性产物，构建脚本不在本仓库 ─────────────
#
# 这些是从 Termux debs / npm registry / NDK 编译出来的大二进制，
# 合计 112.7 MB，且**无法从本仓库重建**（见 AGENTS.md「重新生成资产」）。
# 单独备份，不入库。
#
# 例外：手写源码，必须入库。
#   webview-polyfill.js    —— 旧 WebView 内核兼容垫片
#   dsh-android-shell.mjs  —— uid 2000 执行通道（含 ADB 协议与密钥信任逻辑）
app/src/main/assets/*
!app/src/main/assets/webview-polyfill.js
!app/src/main/assets/dsh-android-shell.mjs
COMMIT_MSG.tmp

# ── 介绍片：中间产物不入库，源文件与成片入库 ─────────────
#
# tmp/   逐帧 PNG/JPEG（3804 张）与探针采样帧，几十 MB，跑一次 render.mjs 就有
# clips/ 每屏一个 mp4 分段，assemble.mjs 的输入，可由 tmp/ 重建
#
# 入库的是：scenes.html（场景页）、video.config.mjs（台词与时长）、*.mjs（渲染
# 管线）、assets/（实机截图素材）、shots/（真机原始截图）、out/（成片）。
video/tmp/
video/clips/
