<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        申请「忽略电池优化」白名单。国产 ROM（华为/OPPO 等）会在息屏后冻结后台应用，
        仅靠前台服务 + WakeLock 仍会被杀。侧载分发，不受 Google Play 对该权限的限制。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        外部存储读写。用途只有一个：让 **app 身份** 能读 uid 2000（`shell` 工具）
        写进 /sdcard 的文件。

        uid 2000 在 /sdcard 上建的文件属主是 `root:sdcard_rw`、模式 `640`
        （sdcardfs 的固定行为，`chmod 666` 改不动），而 app 进程默认的附加组里
        没有 `sdcard_rw`（实测引擎进程 `Groups: 3003 9997 20324 50324`），
        于是 `shell` 截的图 `bash` 读不了。

        ⚠️ 机制**不是**「授权后进程多一个 GID」—— 实测同一个 pid 在授权前后
        `Groups` 一个字节都没变，platform.xml 里这两条权限也确实没有 gid 属性。
        真正变的是 **sdcardfs 按权限把 /storage/emulated 绑到不同的 runtime 视图**：

            未授权 -> /storage/emulated ... gid=1015(sdcard_rw), mask=6   ← default 视图
            已授权 -> /storage/emulated ... gid=9997(everybody), mask=7   ← write 视图
            对照：launcher（无写权限）-> gid=9997, mask=23

        进程自带 9997 组、**不带** 1015 —— 所以未授权时它落在 gid=1015 的 default
        视图里，组对不上，读不了；授权后切到 gid=9997 的 write 视图，组对上了，
        再配合 `derive_gid`（底层文件的 gid 1015 被派生映射成视图的 gid 9997），
        就凭自带的 9997 组读得到那个 `root:sdcard_rw 640` 的文件。

        换句话说：**授权是解开跨身份读取的唯一钥匙**，没有别的办法
        （`chmod` 改不动 sdcardfs 的属主）。

        targetSdk = 28，系统仍走 legacy 存储模型（无分区存储），这两个权限在
        Android 10 上照旧生效，不必申请 MANAGE_EXTERNAL_STORAGE。
        用户拒绝时只是退回原状（跨身份交接需绕道 app 自己的外部目录），不影响其它功能。
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".DshApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DSH"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local AI agent engine keeps a long-running conversation session" />
        </service>

        <!--
            接收通知栏「直接回复」里输入的无线调试配对码。

            ⚠️ 必须静态声明（不能动态注册）：通知可能在 App 进程已被系统回收时
            仍留在通知栏，那时动态注册的接收器已经不存在了，用户回复的配对码
            会石沉大海。
        -->
        <receiver
            android:name=".AdbPairingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dsh.android.action.PAIRING_REPLY" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
