<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：Web 视图（官方 Web GUI）+ 启动过渡层。

  ⚠️ 这里是**空容器**而不是直接写 `<WebView>`：本 App 有两个 Web 内核版本
     （system = 系统 WebView、gecko = 内置 GeckoView），承载控件由
     `WebHostFactory` 在运行期决定（见 com.dsh.android.web.WebHost），
     布局里放不下写死的控件类型。

  启动层的设计意图（配色与图标同源，见 AGENTS.md 的图标一节）：
    · 深色底 + 径向渐变，中心比四周略亮，把视线收到头像上
    · 圆形头像徽章居中，外围旋转光环 + 真实进度环
    · 文案两行：阶段名 + 补充说明，字号/字距克制

  ⚠️ overlay 是**不透明**的，且盖在 Web 视图之上。收尾时必须走淡出动画
     （见 MainActivity.hideOverlay），直接 setVisibility(GONE) 会出现硬切。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/boot_background"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <!-- 动画主体：头像 + 双层环 -->
            <com.dsh.android.BootAnimationView
                android:id="@+id/bootAnim"
                android:layout_width="190dp"
                android:layout_height="190dp" />

            <!-- 应用名。字距拉开，与头像的圆形构成视觉平衡 -->
            <TextView
                android:id="@+id/overlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:letterSpacing="0.32"
                android:text="@string/app_name"
                android:textColor="#EAF0FA"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- 阶段名 -->
            <TextView
                android:id="@+id/overlayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="准备中…"
                android:textColor="#8FA3C0"
                android:textSize="13.5sp" />

            <!-- 补充说明：解释"为什么慢"，把等待变成可理解的过程 -->
            <TextView
                android:id="@+id/overlayHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="#5A6B85"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!--
              安全模式入口：**只在失败态**显示（见 MainActivity.showOverlay）。

              为什么需要它：启动前体检（EngineManager.preflight）能自动修掉四类
              可指认的坏法，但覆盖不到的情况真实存在（坏法超出那四类、体检超时、
              或者坏在体检看不见的地方）。那时 App 依然打不开，而用户手上没有任何
              出路 —— 只能卸载重装，那会清掉全部会话与凭据。

              文案刻意写清楚"不会丢会话"，因为这一步是破坏性的：用户需要知道
              代价是什么才敢点。

              ⚠️ 用 TextView 而不是 Button：主题是 `Theme.Material3.*`，它会给
              Button 套一层自己的实心紫底，把 android:background 顶掉（真机实测
              显示成一大块实心紫）。气泡里那几个按钮同样是 TextView，照抄既有写法。
            -->
            <TextView
                android:id="@+id/overlaySafeMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/overlay_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.06"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="@string/safe_mode_entry"
                android:textColor="#DCE6F5"
                android:textSize="13sp"
                android:visibility="gone" />

            <!--
              日志入口 —— **启动层上唯一一个任何状态都显示的按钮**。

              ## 为什么它不能像「安全模式」那样只在失败态出现

              用户报的问题有一大半是「能打开但用不了」：某个功能点了没反应、
              插件没生效、回复报错。这时启动层早就淡出了，用户手上没有任何
              看日志的地方 —— 而设置页在 Web GUI 里，而 Web GUI 恰恰可能就是
              打不开的那一环。

              所以这一条是**兜底通路**：只要启动层还在（引擎起不来、页面加载不出来、
              插件把启动搞崩），它就一定在。加上设置页那条，两条路覆盖了
              「界面能开」与「界面开不了」两种情况。

              ## 为什么放在启动层最下方、且样式弱于安全模式

              启动期它不该抢注意力（大多数时候用户用不上）。但在失败态，
              它比「安全模式」更该被先点 —— 安全模式会推开插件配置，
              是不可逆的破坏性操作；而看日志没有代价。

              ⚠️ 用 TextView 而不是 Button，理由同上面的安全模式按钮：
              `Theme.Material3.*` 会给 Button 套实心紫底。
            -->
            <TextView
                android:id="@+id/overlayLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/log_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.06"
                android:paddingStart="18dp"
                android:paddingTop="9dp"
                android:paddingEnd="18dp"
                android:paddingBottom="9dp"
                android:text="@string/overlay_logs_entry"
                android:textColor="#8FA3C0"
                android:textSize="12.5sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
